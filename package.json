{
  "name": "leads-generator",
  "version": "1.0.0",
  "description": "B2B Lead Extraction, Cleaning, and Data Pipeline CLI & Webhook API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "db:push": "prisma db push --accept-data-loss",
    "crawl": "tsx src/cli/run-website-crawler.ts",
    "enqueue": "tsx src/cli/run-queue-producer.ts",
    "worker": "prisma db push --accept-data-loss && tsx src/queue/lead.worker.ts",
    "api:start": "prisma db push --accept-data-loss && tsx src/api/server.ts",
    "test:pipeline": "tsx src/cli/test-pipeline.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^5.21.1",
    "apify-client": "^2.11.2",
    "bullmq": "^5.41.6",
    "cheerio": "^1.0.0",
    "crawlee": "^3.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "libphonenumber-js": "^1.13.10",
    "playwright": "^1.48.2",
    "tsx": "^4.19.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prisma": "^5.21.1",
    "typescript": "^5.6.3"
  }
}
