datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id            String          @id @default(uuid())
  leadHash      String          @unique // Hash determinista md5(website | phoneE164)
  companyName   String
  niche         String
  city          String?
  country       String?
  address       String?
  website       String?         // NO usar @unique
  phoneE164     String?         
  primaryEmail  String?
  status        LeadStatus      @default(NEW)
  score         Int             @default(0)
  
  socialProfiles SocialProfile[]
  contacts       ContactPerson[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model SocialProfile {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  platform    Platform 
  url         String
  username    String?
  followers   Int?
  bio         String?
  emailInBio  String?
  verified    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([leadId, platform])
  @@index([platform, username])
}

model ContactPerson {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String?
  role        String? 
  email       String?
  phone       String?
  linkedinUrl String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Platform {
  GOOGLE_MAPS
  INSTAGRAM
  TIKTOK
  LINKEDIN
  FACEBOOK
}

enum LeadStatus {
  NEW
  ENRICHING
  ENRICHED
  QUALIFIED
  REJECTED
}
